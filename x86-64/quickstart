#!/bin/sh
# Native LAN settings; intentionally no QuickStart daemon or login auto-launch.
set -f
[ "$(id -u)" = 0 ] || { echo 'Run this command as root.' >&2; exit 1; }
tmp=$(mktemp -d) || exit 1
trap 'rm -rf "$tmp"' EXIT
trap 'exit 1' HUP INT TERM
uc() { uci -q -t "$tmp" "$@"; }
get() { uci -q get "$1"; }
clean() {
    [ -z "$(uci -q changes network)$(uci -q changes dhcp)" ] || {
        echo 'Pending network or DHCP changes exist. Save or revert them in the original page first.'; return 1;
    }
}
ask() {
    if [ -n "$2" ]; then printf '%s [%s]: ' "$1" "$2"; else printf '%s: ' "$1"; fi
    IFS= read -r answer || return 1
    [ -n "$answer" ] || answer=$2
}
valid() {
    # Input is data, never shell/UCI command text. IPv4 only in this small menu.
    case "$addr$mask$gateway$dns" in *[!0-9.\ -]*) return 1;; esac
    awk -v ip="$addr" -v mask="$mask" -v gw="$gateway" -v dns="$dns" '
    function ipv4(s, a,n,i,v) {
        n=split(s,a,"."); if(n!=4)return -1; v=0;
        for(i=1;i<=4;i++) {
            if(a[i]!~/^[0-9]+$/ || length(a[i])>3 || a[i]>255 || (length(a[i])>1 && substr(a[i],1,1)=="0"))return -1;
            v=v*256+a[i];
        }
        return v;
    }
    function host(s, v) { v=ipv4(s); return v>=16777216 && v<3758096384 && int(v/16777216)!=127; }
    BEGIN {
        m=ipv4(mask); size=4294967296-m; p=1;
        while(p<size && p<2147483648)p*=2;
        if(p!=size || size<4 || size>2147483648 || !host(ip))exit 1;
        v=ipv4(ip); part=v%size; if(part==0 || part==size-1)exit 1;
        if(gw!="-") {
            g=ipv4(gw); if(!host(gw) || int(v/size)!=int(g/size) || g==v || g%size==0 || g%size==size-1)exit 1;
        }
        if(dns!="-") {
            n=split(dns,a," "); if(n<1 || n>3)exit 1;
            for(i=1;i<=n;i++)if(!host(a[i]))exit 1;
        }
    }' </dev/null
}
show() {
    printf '\nCurrent network settings\nLAN device: %s\n' "$(get network.lan.device)"
    printf 'Active IPv4 address: %s\n' "$(ubus call network.interface.lan status 2>/dev/null | jsonfilter -e '@["ipv4-address"][*].address')"
    printf 'Protocol: %s\nIP address: %s\nSubnet mask: %s\n' "$(get network.lan.proto)" "$(get network.lan.ipaddr)" "$(get network.lan.netmask)"
    printf 'Gateway: %s\nDNS: %s\n' "$(get network.lan.gateway)" "$(get network.lan.dns)"
}
while :; do
    printf '\n       JohnnyWrt Network Settings\n'
    printf '\n  1. Show network settings\n  2. Set IP address, gateway and DNS\n  3. Exit\n\nSelect [3]: '
    IFS= read -r choice || exit 0
    case "$choice" in
        3|'') exit 0;;
        1) show; continue;;
        2) ;;
        *) echo 'Select 1, 2 or 3.'; continue;;
    esac
    clean || exit 1
    case "$(get network.lan.proto)" in static|dhcp) ;; *) echo 'LAN is not a simple static/DHCP interface. Use the advanced network settings in the web UI.'; exit 1;; esac
    case "$(get network.lan.ipaddr)" in *' '*|*/*) echo 'LAN uses multiple addresses or CIDR. Use the advanced network settings in the web UI.'; exit 1;; esac
    ask 'IP address (required)' '' || exit 0; addr=$answer
    ask 'Subnet mask' '255.255.255.0' || exit 0; mask=$answer
    ask 'Gateway (required; - for none)' '' || exit 0; gateway=$answer
    echo 'Enter up to 3 DNS IPv4 addresses separated by spaces, or - for none.'
    ask 'DNS server' '223.5.5.5' || exit 0; dns=$answer
    if ! valid; then echo 'Invalid settings: check the IPv4 address, subnet mask, gateway in the same subnet and DNS. No changes saved.'; continue; fi
    printf '\nSet LAN to a static IP address:\nIP address: %s\nSubnet mask: %s\nGateway: %s\nDNS: %s\n' "$addr" "$mask" "$gateway" "$dns"
    echo 'Existing LAN DHCP service settings, devices and other interfaces will be preserved.'
    echo 'Applying will disconnect the current network connection. There is no automatic rollback; use the local console to change settings again.'
    printf 'Save and apply? [y/N]: '
    IFS= read -r answer || exit 0
    case "$answer" in y|Y) ;; *) echo 'Cancelled.'; continue;; esac
    clean || exit 1
    # Stage only in our private delta directory. Check every write before commit.
    uc set network.lan.proto=static && uc set "network.lan.ipaddr=$addr" &&
    uc set "network.lan.netmask=$mask" && uc set network.lan.peerdns=0 || exit 1
    uc delete network.lan.gateway; uc delete network.lan.dns
    [ "$gateway" = - ] || uc set "network.lan.gateway=$gateway" || exit 1
    if [ "$dns" != - ]; then
        for server in $dns; do uc add_list "network.lan.dns=$server" || exit 1; done
    fi
    clean || exit 1
    # Save the original locally so a failed commit can be restored.
    uci export network > "$tmp/network.backup" || exit 1
    if ! uc commit network; then
        uci import network < "$tmp/network.backup"; uci commit network
        echo 'Save failed. Attempted to restore the original configuration.' >&2; exit 1
    fi
    sync
    printf 'Saved. Reconnect with SSH: ssh root@%s\nWeb UI: http://%s/\n' "$addr" "$addr"
    (trap '' HUP; sleep 2; reload_config) </dev/null >/tmp/johnny-network-apply.log 2>&1 &
    exit 0
done
