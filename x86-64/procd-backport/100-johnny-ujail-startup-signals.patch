diff --git a/service/instance.c b/service/instance.c
index 51d85b0..73a3efd 100644
--- a/service/instance.c
+++ b/service/instance.c
@@ -625,9 +625,10 @@ instance_free_stdio(struct service_instance *in)
 void
 instance_start(struct service_instance *in)
 {
-	int pid, ret;
 	int opipe[2] = { -1, -1 };
 	int epipe[2] = { -1, -1 };
+	sigset_t oldset;
+	int pid, ret;
 
 	if (!avl_is_empty(&in->errors.avl)) {
 		LOG("Not starting instance %s::%s, an error was indicated\n", in->srv->name, in->name);
@@ -666,11 +667,23 @@ instance_start(struct service_instance *in)
 	if (!in->valid)
 		return;
 
+	procd_signal_block(&oldset);
+
 	pid = fork();
-	if (pid < 0)
+	if (pid < 0) {
+		procd_signal_restore(&oldset);
 		return;
+	}
 
 	if (!pid) {
+		procd_signal_reset();
+		/*
+		 * A signal sent to a starting instance, e.g. the reload SIGHUP,
+		 * would kill ujail before it installs its handlers. Keep the
+		 * signals pending; ujail unblocks them once it can forward them.
+		 */
+		if (!in->has_jail)
+			procd_signal_restore(&oldset);
 		uloop_done();
 		closefd(opipe[0]);
 		closefd(epipe[0]);
@@ -683,6 +696,8 @@ instance_start(struct service_instance *in)
 		return;
 	}
 
+	procd_signal_restore(&oldset);
+
 	P_DEBUG(2, "Started instance %s::%s[%d]\n", in->srv->name, in->name, pid);
 	in->proc.pid = pid;
 	instance_writepid(in);
diff --git a/signal.c b/signal.c
index 7cbbe1a..79d0596 100644
--- a/signal.c
+++ b/signal.c
@@ -104,3 +104,34 @@ void procd_signal(void)
 	reboot(RB_DISABLE_CAD);
 #endif
 }
+
+void procd_signal_reset(void)
+{
+	struct sigaction s = { 0 };
+	int i;
+
+	s.sa_handler = SIG_DFL;
+
+	for (i = 1; i < _NSIG; i++)
+		sigaction(i, &s, NULL);
+}
+
+void procd_signal_block(sigset_t *oldset)
+{
+	sigset_t set;
+
+	sigemptyset(&set);
+	sigaddset(&set, SIGTERM);
+	sigaddset(&set, SIGINT);
+	sigaddset(&set, SIGUSR1);
+	sigaddset(&set, SIGUSR2);
+	sigaddset(&set, SIGPWR);
+	sigaddset(&set, SIGHUP);
+
+	sigprocmask(SIG_BLOCK, &set, oldset);
+}
+
+void procd_signal_restore(const sigset_t *oldset)
+{
+	sigprocmask(SIG_SETMASK, oldset, NULL);
+}
